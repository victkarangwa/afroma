{
  "expo": {
    "name": "Afroma",
    "slug": "afroma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/afroma_logo.png",
    "scheme": "net.afroma.app",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/afroma_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d1b2c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.afroma.app",
      "buildNumber": "0",
      "icon": "./assets/images/afroma_logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/afroma_logo.png",
        "backgroundColor": "#1d1b2c"
      },
      "package": "net.afroma.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/afroma_logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.net.afroma.app"
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1921081955393227",
          "clientToken": "b3408f0f4a88fbf5eb88ca6469240b35",
          "displayName": "Afroma",
          "scheme": "fb1921081955393227",
          "advertiserIDCollectionEnabled": false,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": true,
          "iosUserTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "victkarangwa"
  }
}
