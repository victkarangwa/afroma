{
  "expo": {
    "name": "Parenti",
    "slug": "parenti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/parenti_logo.png",
    "scheme": "parenti",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/parenti_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d1b2c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.parenti.app",
      "buildNumber": "0",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "io.parenti.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "victkarangwa"
  }
}
